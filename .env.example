# LLM provider keys. Set the one matching config.llm.provider (watchtower.yaml).
# Any OpenAI-compatible endpoint works for the default 'openai' provider.
OPENAI_API_KEY=

# Other providers (only the selected provider's key is needed; Ollama needs none):
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional: point at a non-default OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: absolute path to a specific config file. By default Watchtower finds
# watchtower.yaml at your project root automatically, so this is rarely needed.
# WATCHTOWER_CONFIG=/absolute/path/to/watchtower.yaml
