# OpenAI-compatible LLM configuration.
# Any endpoint that speaks the OpenAI API works (OpenAI, Azure OpenAI, Ollama, vLLM, ...).
OPENAI_API_KEY=

# Optional: point at a non-default OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the default config file location.
WATCHTOWER_CONFIG=watchtower.yaml
